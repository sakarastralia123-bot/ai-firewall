{
  "manifest_version": 3,
  "name": "Nepali AI Firewall",
  "version": "1.0",
  "description": "Automatically redacts Nepali names, phones, and passwords before sending to AI.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://sovereign-api-pepf.onrender.com/*" 
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Firewall Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}